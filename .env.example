# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Oura Ring personal access token (https://cloud.ouraring.com/personal-access-tokens)
OURA_TOKEN=

# Optional — unlock richer obsidian-second-brain research commands.
# Everything works without these via key-less fallback sources.
# XAI_API_KEY=
# PERPLEXITY_API_KEY=
# GEMINI_API_KEY=
# YOUTUBE_API_KEY=

# Gemini as a Part 2b backend (scripts/llm_backends.py, added 2026-10-02).
# GEMINI_API_KEY above is reused. Model is chosen per run: --model gemini:<name>
# (list available names with: python scripts/llm_backends.py list-models).
# GEMINI_MIN_INTERVAL_S=4         # pacing between calls (~15/min)
# GEMINI_DAILY_MAX_CALLS=1000     # hard daily stop; batch ends cleanly when hit
# GEMINI_THINKING_BUDGET=4096     # thinking tokens for full-thinking steps
