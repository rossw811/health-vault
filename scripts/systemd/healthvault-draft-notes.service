[Unit]
Wants=healthvault-ollama-gpu.service
After=healthvault-ollama-gpu.service
Description=Health Vault local-LLM assisted-draft generation (youtube)

[Service]
Type=oneshot
WorkingDirectory=%h/Health
Environment=OLLAMA_HOST=http://127.0.0.1:11435
ExecStart=%h/Health/.venv/bin/python %h/Health/scripts/generate_draft_notes.py youtube --batch-size 20
